rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- Helpers ----------------
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userEmail() {
      return (request.auth != null && request.auth.token.email != null) ? request.auth.token.email.lower() : '';
    }

    function isAdmin() {
      return isSignedIn() && (
        userEmail() in [
          'aldojeda92@gmail.com',
          'adairojeda.adm@gmail.com',
          'antoninovazquezjara@gmail.com',
          'aldo.ojeda@datacarpy.com'
        ] ||
        userEmail().matches('^.+@datacarpy\\.com$') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         userDoc().data.get('role', '').lower() in ['admin', 'administrador', 'superadmin'])
      );
    }

    function isConcesionaria() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userDoc().data.get('role', '').lower() in ['concesionaria', 'dealer'];
    }

    function myBrands() {
      return userDoc().data.get('marcasPermitidas', []);
    }

    function myDealershipNorm() {
      return userDoc().data.get('dealershipName', '').upper().trim();
    }

    // ¿La marca (por id) está en la lista de marcas permitidas de la concesionaria?
    function brandNameAllowed(bName) {
      return bName in myBrands() || bName.upper() in myBrands() || bName.lower() in myBrands();
    }

    function brandAllowed(brandId) {
      return isAdmin() || (
        isConcesionaria() &&
        exists(/databases/$(database)/documents/brands/$(brandId)) &&
        brandNameAllowed(get(/databases/$(database)/documents/brands/$(brandId)).data.name)
      );
    }

    function modelBrandAllowed(modelId) {
      return isAdmin() || (
        isConcesionaria() && (
          (exists(/databases/$(database)/documents/models/$(modelId)) &&
           brandAllowed(get(/databases/$(database)/documents/models/$(modelId)).data.brandId)) ||
          (existsAfter(/databases/$(database)/documents/models/$(modelId)) &&
           brandAllowed(getAfter(/databases/$(database)/documents/models/$(modelId)).data.brandId))
        )
      );
    }

    // ---------------- users ----------------
    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    // ---------------- brands ----------------
    match /brands/{brandId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isConcesionaria() && brandAllowed(brandId));
    }

    // ---------------- models ----------------
    match /models/{modelId} {
      allow read: if true;
      allow create: if isAdmin() ||
        (isConcesionaria() && brandAllowed(request.resource.data.brandId));
      allow update: if isAdmin() || (
        isConcesionaria() &&
        brandAllowed(resource.data.brandId) &&
        brandAllowed(request.resource.data.brandId)
      );
      allow delete: if isAdmin() ||
        (isConcesionaria() && brandAllowed(resource.data.brandId));
    }

    // ---------------- versions ----------------
    match /versions/{versionId} {
      allow read: if true; // catálogo público, lo consume el comparador
      allow create: if isAdmin() ||
        (isConcesionaria() && modelBrandAllowed(request.resource.data.modelId));
      allow update: if isAdmin() || (
        isConcesionaria() &&
        modelBrandAllowed(resource.data.modelId) &&
        modelBrandAllowed(request.resource.data.modelId)
      );
      allow delete: if isAdmin() ||
        (isConcesionaria() && modelBrandAllowed(resource.data.modelId));
    }

    // ---------------- campaigns (ads) ----------------
    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------- concesionarias (entidad) ----------------
    match /concesionarias/{concId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------- config (financial, etc.) ----------------
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------- blog_posts (artículos del blog) ----------------
    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------- video_reviews (reseñas y reels IG) ----------------
    match /video_reviews/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------- leads ----------------
    match /leads/{leadId} {
      allow create: if true;

      allow get, list: if isAdmin() || (
        isConcesionaria() && (
          resource.data.concesionaria_destino_norm == myDealershipNorm() ||
          resource.data.concesionaria_destino_norm == 'CHAT_AUTORIZADO_MARCA'
        )
      );

      allow update: if true;

      allow delete: if isAdmin();
    }

    // ---------------- dealership_requests ----------------
    match /dealership_requests/{reqId} {
      allow create: if true;
      allow get, list, update, delete: if isAdmin();
    }

    // ---------------- newsletter_subscribers & newsletter ----------------
    match /newsletter_subscribers/{subId} {
      allow create: if true;
      allow list: if isAdmin() || request.query.limit <= 1;
      allow get, update, delete: if isAdmin();
    }

    match /newsletter/{subId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // ---------------- comparison_stats (telemetría) ----------------
    match /comparison_stats/{statId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // ---------------- wizard_stats (telemetría de preferencias del recomendador) ----------------
    match /wizard_stats/{statId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // ---------------- preference_telemetry (telemetría de preferencias del comparador dinámico) ----------------
    match /preference_telemetry/{prefId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // ---------------- audit_logs ----------------
    match /audit_logs/{logId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }

    // ---------------- chat_sessions & messages (Chat Online por Marca) ----------------
    // El documento de sesión NUNCA guarda el teléfono del usuario para protegerlo de spam.
    match /chat_sessions/{chatId} {
      allow create: if true;
      allow get, list: if true;
      allow update: if true;
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow create: if true;
        allow get, list: if true;
        allow update, delete: if isAdmin();
      }
    }

    // ---------------- chat_private_contacts (Celulares protegidos: SOLO ADMIN) ----------------
    // Guarda el celular ingresado por el usuario al iniciar un chat. La concesionaria NO tiene permiso de lectura.
    match /chat_private_contacts/{chatId} {
      allow create, update: if true;
      allow get, list, delete: if isAdmin();
    }

    // ---------------- chat_telemetry (Eventos de apertura/interacción del funnel de Chat Online) ----------------
    match /chat_telemetry/{eventId} {
      allow create, update: if true;
      allow get, list, delete: if isAdmin();
    }

    // Todo lo no listado explícitamente: denegado por defecto.
  }
}
